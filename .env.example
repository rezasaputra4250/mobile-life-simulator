# Kosongkan agar mobile otomatis memakai IP host Expo saat development.
# Untuk device fisik, komputer dan device harus berada di jaringan Wi-Fi yang sama.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_URL_LOCAL=
EXPO_PUBLIC_API_URL_DEVELOPMENT=
EXPO_PUBLIC_API_URL_STAGING=
EXPO_PUBLIC_API_URL_PRODUCTION=https://api-life-simulator.rezasaputra.id/
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=5000
EXPO_PUBLIC_API_DEBUG=false
